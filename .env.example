# URL base de tus webhooks de n8n (sin "/" final). Ej: https://tu-n8n.com/webhook
VITE_N8N_API_URL=
# API key que validará n8n
VITE_N8N_API_KEY=
# (Solo demo local) true = datos de ejemplo sin n8n. NO usar en producción.
# VITE_USE_MOCK=true

# (Opcional) nombre del header donde se envía la key. Por defecto: x-api-key
VITE_N8N_API_KEY_HEADER=x-api-key
